# Modelo das variaveis de TESTE de integracao (SO NOMES; nunca coloque valores aqui).
# Copie para supabase/.env.test (fora do Git). Nunca aponte para producao ou homologacao.
# Guia: supabase/spec/research/04-estrategia-de-testes.md (secao 6.3, decisao C-6)

# OBRIGATORIA | URL https do projeto Supabase DEDICADO a testes
SBX_TEST_URL=
# OBRIGATORIA | SEGREDO | chave secret do projeto de teste
SBX_TEST_SECRET_KEY=
# OBRIGATORIA para rodar integracao | consentimento explicito: 1
SBX_TEST_ALLOW_LIVE=
# OBRIGATORIA | bucket de teste (prefixo it-)
SBX_TEST_BUCKET=
# OBRIGATORIA | identificador esperado do projeto de teste (guarda de ambiente)
SBX_TEST_PROJECT_REF=
