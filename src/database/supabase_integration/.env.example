# Modelo de variaveis da integracao Supabase (SO NOMES; nunca coloque valores aqui).
# Copie para o ambiente do processo (dev: .env local; homol/prod: variaveis da plataforma).
# Fonte da verdade: SettingsLoader.variable_names() (bai_supabase/config/loader.py).
# Guia: supabase/spec/research/01-variaveis-de-ambiente.md

# --- Ambiente e conexao ---
# opcional | enum dev|homol|prod | padrao dev
SBX_ENV=
# OBRIGATORIA | URL https do projeto (http so para localhost em dev)
SBX_URL=
# OBRIGATORIA | SEGREDO | chave secret do backend (nunca no frontend)
SBX_SECRET_KEY=
# opcional | SEGREDO | chave publishable (reservada; so com RLS)
SBX_PUBLISHABLE_KEY=
# opcional | str | padrao public
SBX_DB_SCHEMA=
# opcional | SEGREDO | reservada e ignorada na v1
SBX_DB_CONNECTION_STRING=
# opcional | float > 0 | padrao 10
SBX_HTTP_TIMEOUT_SECONDS=
# opcional | float > 0 | padrao 3
SBX_HTTP_CONNECT_TIMEOUT_SECONDS=
# opcional | int >= 1 | padrao 3 | TOTAL de tentativas (1 = sem retry)
SBX_RETRY_MAX_ATTEMPTS=
# opcional | float > 0 | padrao 0.5
SBX_RETRY_BACKOFF_BASE_SECONDS=
# opcional | float >= base | padrao 8
SBX_RETRY_BACKOFF_MAX_SECONDS=
# opcional | float > 0 | padrao 30
SBX_RETRY_BUDGET_SECONDS=
# opcional | str | identificador do projeto; deve casar com SBX_URL
SBX_EXPECTED_PROJECT_REF=
# opcional | bool | padrao false | proibido em homol/prod
SBX_ALLOW_LEGACY_FALLBACK=

# --- Tabelas ---
# opcional (OBRIGATORIA em prod) | lista por virgula | vazio = qualquer tabela
SBX_TABLES_ALLOWLIST=
# opcional | int >= 1 | padrao 50 (<= max)
SBX_TABLES_DEFAULT_PAGE_SIZE=
# opcional | int >= 1 | padrao min(1000, server max rows)
SBX_TABLES_MAX_PAGE_SIZE=
# opcional | int >= 1 | padrao 500
SBX_TABLES_BATCH_SIZE=
# opcional | int >= 1 | padrao 1000 | max-rows real do projeto
SBX_TABLES_SERVER_MAX_ROWS=
# opcional | float > 0 | padrao 10
SBX_TABLES_QUERY_TIMEOUT_SECONDS=
# opcional | float > 0 | padrao 60
SBX_TABLES_BATCH_TIMEOUT_SECONDS=

# --- Arquivos (storage) ---
# opcional | str | bucket padrao
SBX_BUCKET_DEFAULT=
# opcional (OBRIGATORIA em prod) | lista por virgula | vazio = so o bucket padrao
SBX_BUCKETS_ALLOWLIST=
# opcional | lista por virgula | buckets publicos
SBX_BUCKETS_PUBLIC=
# opcional | int >= 1 | padrao 52428800 (50 MiB)
SBX_STORAGE_MAX_FILE_BYTES=
# opcional | lista por virgula | aceita curinga image/* | vazio = qualquer
SBX_STORAGE_ALLOWED_MIME=
# opcional | int >= 1 | padrao 300
SBX_STORAGE_SIGNED_URL_TTL_SECONDS=
# opcional | int >= 1 | padrao 3600 | teto de expiracao
SBX_STORAGE_SIGNED_URL_MAX_TTL_SECONDS=
# opcional | float > 0 | padrao 120
SBX_STORAGE_UPLOAD_TIMEOUT_SECONDS=
# opcional | bool | padrao false
SBX_STORAGE_UPSERT_DEFAULT=
# opcional | int >= 0 | padrao 3600
SBX_STORAGE_CACHE_CONTROL_SECONDS=
# opcional | int >= 1 | padrao 6291456 (6 MiB)
SBX_STORAGE_RESUMABLE_THRESHOLD_BYTES=
# opcional | int >= 1 | padrao 6291456 (6 MiB)
SBX_STORAGE_RESUMABLE_CHUNK_BYTES=
# opcional | int >= 1 | padrao 33554432 (32 MiB)
SBX_STORAGE_MEMORY_CAP_BYTES=
# opcional | int >= 1 | padrao 100
SBX_STORAGE_LIST_PAGE_SIZE=
# opcional | int >= 1 | padrao 100
SBX_STORAGE_DELETE_BATCH_SIZE=
# opcional | int >= 1 | padrao 4
SBX_STORAGE_MAX_CONCURRENT_TRANSFERS=

# --- Log ---
# opcional | DEBUG|INFO|WARNING|ERROR | padrao por ambiente (dev DEBUG, homol INFO, prod WARNING)
SBX_LOG_LEVEL=
# opcional | auto|on|off | padrao por ambiente (prod off)
SBX_LOG_COLOR=
# opcional | pretty|json | padrao por ambiente (prod json)
SBX_LOG_FORMAT=
# opcional | int >= 0 | padrao 1000 | 0 desliga o destaque de lentidao
SBX_LOG_SLOW_MS=
# opcional | int >= 20 | padrao 200
SBX_LOG_MAX_FIELD_CHARS=
