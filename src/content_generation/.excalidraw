    },
    {
      "id": "tPZdSMkc26KAlFIkcblsA",
      "type": "text",
      "x": 1507.6166832937924,
      "y": 404.08567365565557,
      "width": 798.752615346979,
      "height": 89.32630826804593,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
        "Z0PHqzfw7vwt9t0xcuJVZ"
      ],
      "frameId": "UzqEqqU791PubplWDId_X",
      "index": "b0q",
      "roundness": null,
      "seed": 977120844,
      "version": 701,
      "versionNonce": 829918284,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784472642802,
      "link": null,
      "locked": false,
      "text": "Malbec Magnetic de O Boticário oferece uma experiência olfativa irresistível e sofisticada, perfeita para o homem contemporâneo que\nbusca uma fragrância marcante e envolvente. Com notas amadeiradas que se combinam harmoniosamente com nuances frutais provenientes\ndas uvas cultivadas no solo mineral da Alsácia, esta fragrância proporciona um equilíbrio único de frescor e profundidade. O toque de\npatchouli e âmbar confere personalidade e elegância à colônia, tornando-a ideal para ocasiões especiais, encontros ou momentos em que a\npresença deve ser notada sem perder a sofisticação. Além disso, é um produto vegano que alia qualidade e consciência ambiental. Uma\nescolha certeira para quem deseja realçar o poder de sedução com muita classe e distinção.",
      "fontSize": 11.910174435739458,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Malbec Magnetic de O Boticário oferece uma experiência olfativa irresistível e sofisticada, perfeita para o homem contemporâneo que busca uma fragrância marcante e envolvente. Com notas amadeiradas que se combinam harmoniosamente com nuances frutais provenientes das uvas cultivadas no solo mineral da Alsácia, esta fragrância proporciona um equilíbrio único de frescor e profundidade. O toque de patchouli e âmbar confere personalidade e elegância à colônia, tornando-a ideal para ocasiões especiais, encontros ou momentos em que a presença deve ser notada sem perder a sofisticação. Além disso, é um produto vegano que alia qualidade e consciência ambiental. Uma escolha certeira para quem deseja realçar o poder de sedução com muita classe e distinção.",
      "autoResize": false,
      "lineHeight": 1.25
    },
