    {
      "id": "RTls2fh1nMek0o1G_Xctr",
      "type": "text",
      "x": 1509.9429500018778,
      "y": 332.6710094734684,
      "width": 798.752615346979,
      "height": 29.775436089348645,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
        "Z0PHqzfw7vwt9t0xcuJVZ"
      ],
      "frameId": "UzqEqqU791PubplWDId_X",
      "index": "b0o",
      "roundness": null,
      "seed": 93360460,
      "version": 624,
      "versionNonce": 589702604,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784472642802,
      "link": null,
      "locked": false,
      "text": "Descubra Malbec Magnetic, a fragrância amadeirada frutal da linha Malbec de O Boticário, ideal para homens sofisticados que desejam\ndeixar uma marca única em qualquer ocasião.",
      "fontSize": 11.910174435739458,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Descubra Malbec Magnetic, a fragrância amadeirada frutal da linha Malbec de O Boticário, ideal para homens sofisticados que desejam deixar uma marca única em qualquer ocasião.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "h3zHhC8ViKGoaYWBIfVTt",
      "type": "text",
      "x": 1506.7177915955654,
      "y": 380.5644729804038,
      "width": 29.228134155273438,
      "height": 14.645335853775208,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
        "Z0PHqzfw7vwt9t0xcuJVZ"
      ],
      "frameId": "UzqEqqU791PubplWDId_X",
